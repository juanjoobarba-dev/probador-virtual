# Copia este archivo, llámalo ".env" y rellena tus datos de MySQL.
# Si dejas DB_HOST vacío, la web funciona en MODO DEMO (con datos de prueba, sin base de datos).

PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=probador_virtual

# Pon true si tu MySQL está en la nube (Aiven, TiDB Cloud...)
DB_SSL=false
